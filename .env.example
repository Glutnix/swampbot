# get from https://discord.com/developers/applications/ App > Bot > Token
DISCORD_TOKEN=

# get from https://discord.com/developers/applications/ App > General Info Application ID
DISCORD_CLIENT_ID=

# where to save the sqlite database
DB_FILE_NAME=file:local.db

# get from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=

# get from https://id.twitch.tv/oauth2/authorize?&response_type=code&scope=chat:read+chat:edit&client_id={CLIENT_ID}&redirect_uri=http://localhost redirect url
TWITCH_ACCESS_TOKEN=
